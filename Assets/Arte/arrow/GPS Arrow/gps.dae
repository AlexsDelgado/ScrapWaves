  <library_effects>
    <effect id="gpsarrow-effect">
      <profile_COMMON>
        <newparam sid="gpsarrow_png-surface">
          <surface type="2D">
            <init_from>gpsarrow_png</init_from>
          </surface>
        </newparam>
        <newparam sid="gpsarrow_png-sampler">
          <sampler2D>
            <source>gpsarrow_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="gpsarrow_png-sampler" texcoord="texcoords"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
